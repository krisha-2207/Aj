generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  STAFF
  DEALER
}

enum OrderStatus {
  PENDING
  APPROVED
  DISPATCHED
  RECEIVED
  COMPLETED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  password      String
  name          String
  role          Role
  phone         String?
  status        String    @default("ACTIVE")
  pharmacyId    String?
  pharmacy      Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  staffProfile  Staff?
  dealerProfile Dealer?
  bills         Bill[]    @relation("StaffBills")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([role])
}

model Pharmacy {
  id             String          @id @default(uuid())
  name           String
  address        String
  phone          String
  email          String?
  gstin          String
  dlNumber       String
  users          User[]
  batches        MedicineBatch[]
  bills          Bill[]
  expenses       Expense[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Staff {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode String   @unique
  designation  String   @default("Pharmacist")
  salary       Float?
  joinedDate   DateTime @default(now())
}

model Dealer {
  id              String           @id @default(uuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  contactPerson   String
  phone           String
  email           String
  gstin           String
  dlNumber        String?
  address         String
  batches         MedicineBatch[]
  purchaseOrders  PurchaseOrder[]
  purchaseReturns PurchaseReturn[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Medicine {
  id                 String              @id @default(uuid())
  productId          String              @unique
  name               String
  genericName        String?
  category           String
  dosageForm         String?             @default("Tablet")
  strength           String?
  manufacturer       String
  hsnCode            String              @default("3004")
  gstRate            Float               @default(12.0)
  unit               String              @default("Strip")
  minStockLevel      Int                 @default(15)
  dosageUsage        String?             @default("Take as advised by physician. Follow prescription directions.")
  batches            MedicineBatch[]
  billItems          BillItem[]
  purchaseOrderItems PurchaseOrderItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([productId])
  @@index([name])
  @@index([category])
}

model MedicineBatch {
  id                String     @id @default(uuid())
  batchNumber       String
  medicineId        String
  medicine          Medicine   @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  dealerId          String?
  dealer            Dealer?    @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  pharmacyId        String?
  pharmacy          Pharmacy?  @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  initialQuantity   Int
  soldQuantity      Int        @default(0)
  remainingQuantity Int
  purchasePrice     Float
  sellingPrice      Float
  mfgDate           DateTime
  expiryDate        DateTime
  receivedDate      DateTime   @default(now())
  billItems         BillItem[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([medicineId, batchNumber])
  @@index([expiryDate])
  @@index([batchNumber])
  @@index([remainingQuantity])
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  orderNumber  String              @unique
  dealerId     String
  dealer       Dealer              @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  pharmacyId   String
  pharmacy     Pharmacy            @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  status       OrderStatus         @default(PENDING)
  totalAmount  Float               @default(0.0)
  orderDate    DateTime            @default(now())
  receivedDate DateTime?
  notes        String?
  items        PurchaseOrderItem[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status])
  @@index([dealerId])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  medicineId      String
  medicine        Medicine      @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchNumber     String
  quantity        Int
  purchasePrice   Float
  sellingPrice    Float
  mfgDate         DateTime
  expiryDate      DateTime
  createdAt       DateTime      @default(now())
}

model Customer {
  id           String   @id @default(uuid())
  customerCode String?  @unique
  name         String
  phone        String   @unique
  email        String?
  address      String?
  age          Int?
  gender       String?
  customerType String   @default("NEW")
  totalVisits  Int      @default(1)
  totalSpent   Float    @default(0.0)
  bills        Bill[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model Bill {
  id              String        @id @default(uuid())
  billNumber      String        @unique
  pharmacyId      String
  pharmacy        Pharmacy      @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  staffId         String
  staff           User          @relation("StaffBills", fields: [staffId], references: [id])
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName    String
  customerPhone   String
  customerType    String        @default("NEW")
  customerAddress String?
  customerAge     Int?
  customerGender  String?
  doctorName      String?       @default("Dr. Self / Consulting Physician")
  paymentMethod   PaymentMethod @default(CASH)
  subtotal        Float
  discount        Float         @default(0.0)
  taxAmount       Float         @default(0.0)
  grandTotal      Float
  items           BillItem[]
  salesReturns    SalesReturn[]
  createdAt       DateTime      @default(now())

  @@index([billNumber])
  @@index([staffId])
  @@index([createdAt])
}

model BillItem {
  id                String        @id @default(uuid())
  billId            String
  bill              Bill          @relation(fields: [billId], references: [id], onDelete: Cascade)
  medicineId        String
  medicine          Medicine      @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchId           String
  batch             MedicineBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  quantity          Int
  unitPrice         Float
  gstRate           Float         @default(12.0)
  usageInstructions String?
  doctorName        String?       @default("Dr. Self / Consulting Physician")
  customerType      String?       @default("NEW")
  total             Float
  createdAt         DateTime      @default(now())

  @@index([batchId])
  @@index([medicineId])
}

model SalesReturn {
  id            String   @id @default(uuid())
  returnNumber  String   @unique
  billId        String?
  bill          Bill?    @relation(fields: [billId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String?
  doctorName    String?  @default("Dr. Self / Consulting Physician")
  medicineName  String
  batchNumber   String
  quantity      Int
  refundAmount  Float
  gstRefund     Float    @default(0.0)
  reason        String
  returnDate    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([returnNumber])
  @@index([billId])
  @@index([returnDate])
}

model PurchaseReturn {
  id           String   @id @default(uuid())
  returnNumber String   @unique
  dealerId     String
  dealer       Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  medicineName String
  batchNumber  String
  quantity     Int
  refundAmount Float
  gstReversal  Float    @default(0.0)
  reason       String
  status       String   @default("PROCESSED")
  returnDate   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([returnNumber])
  @@index([dealerId])
  @@index([returnDate])
}

model Expense {
  id            String   @id @default(uuid())
  pharmacyId    String
  pharmacy      Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  category      String
  title         String
  amount        Float
  paymentMethod String   @default("CASH")
  date          DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())

  @@index([pharmacyId])
  @@index([date])
}
